# package 内 src 只放源码。本地误用包内 tsconfig 就地编译时，tsc 会把 .js 和
# sourcemap 写到源码旁；正常构建输出在 lib/、dist/。手写的 *.d.ts 声明应正常入库。
packages/*/*/src/**/*.js
packages/*/*/src/**/*.js.map
packages/*/*/src/**/*.d.ts.map

# Computer Use helper：本地用 native/macos 的 Swift 源码编译，产物与它的哈希清单不入库。
packages/computer-use/computer-use/native/macos/bin/
packages/computer-use/computer-use/native/macos/manifest.json
