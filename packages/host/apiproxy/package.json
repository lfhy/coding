{
  "name": "coding-host-apiproxy",
  "description": "API gateway: the ApiProxy contract (api/), the fetch carrier pair (fetch/), and the host-side gateway plugin providing ctx.apiProxy",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/host/apiproxy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api/index.d.ts",
      "default": "./lib/types/api/index.js"
    },
    "./api/*": {
      "types": "./lib/types/api/*.d.ts",
      "default": "./lib/types/api/*.js"
    },
    "./client": {
      "types": "./lib/types/fetch/client.d.ts",
      "default": "./lib/types/fetch/client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "coding-attachment": "workspace:^",
    "coding-agent": "workspace:^",
    "coding-agent-default-model": "workspace:^",
    "coding-api-remotes": "workspace:^",
    "coding-brand": "workspace:^",
    "coding-browser": "workspace:^",
    "coding-commands": "workspace:^",
    "coding-credentials": "workspace:^",
    "coding-goal": "workspace:^",
    "coding-host-directory-picker": "workspace:^",
    "coding-llm": "workspace:^",
    "coding-native-command": "workspace:^",
    "coding-session": "workspace:^",
    "coding-session-persistence": "workspace:^",
    "coding-session-projection": "workspace:^",
    "coding-session-projection-cache": "workspace:^",
    "coding-session-query": "workspace:^",
    "coding-session-title": "workspace:^",
    "coding-settings": "workspace:^",
    "coding-skill": "workspace:^",
    "coding-subagent": "workspace:^",
    "coding-subprocess": "workspace:^",
    "coding-jobs": "workspace:^",
    "coding-tools": "workspace:^",
    "coding-user-approval": "workspace:^",
    "coding-user-questions": "workspace:^",
    "coding-workspace": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "fflate": "^0.8.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "coding-agent-presets": "workspace:^",
    "coding-llm-vision-fallback": "workspace:^",
    "coding-cordis-host-runner": "workspace:^",
    "coding-invariants": "workspace:^",
    "coding-proxy-pool": "workspace:^",
    "coding-llm-opencode": "workspace:^"
  },
  "peerDependenciesMeta": {
    "coding-llm-vision-fallback": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "coding-agent-presets": "workspace:^",
    "coding-llm-vision-fallback": "workspace:^",
    "coding-cordis-host-runner": "workspace:^",
    "coding-invariants": "workspace:^",
    "coding-storage": "workspace:^",
    "coding-storage-domain": "workspace:^",
    "coding-typert-protocol": "workspace:^",
    "coding-typert-registry": "workspace:^",
    "coding-proxy-pool": "workspace:^",
    "coding-llm-opencode": "workspace:^"
  }
}
