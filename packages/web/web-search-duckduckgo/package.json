{
  "name": "coding-web-search-duckduckgo",
  "description": "Anonymous DuckDuckGo HTML search provider for the web capability seam",
  "version": "0.1.0-rc.8",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/web/web-search-duckduckgo"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
