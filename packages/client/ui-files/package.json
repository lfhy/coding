{
  "name": "coding-client-ui-files",
  "description": "Read-only managed files settings section",
  "version": "0.1.0-rc.8",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-files"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": { "client": {
    "inject": ["coding-client-locale", "coding-client-runtime", "coding-client-ui-settings"],
    "platform": "web"
  } },
  "scripts": { "bundle": "tsdown", "watch": "tsdown --watch" },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "coding-client-locale": "workspace:^",
    "coding-client-runtime": "workspace:^",
    "coding-client-ui-settings": "workspace:^",
    "coding-invariants": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "coding-client-locale": "workspace:^",
    "coding-client-runtime": "workspace:^",
    "coding-client-ui-settings": "workspace:^",
    "coding-client-ui-slots": "workspace:^",
    "coding-invariants": "workspace:^",
    "@types/react": "~18.3.1",
    "@testing-library/react": "^16.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": ["lib/index.js", "lib/invariant.js", "lib/client.js", "lib/types/**/*.d.ts"]
}
