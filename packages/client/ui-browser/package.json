{
  "name": "coding-client-ui-browser",
  "description": "Session browser tabs, navigation, and observation in the workbench",
  "version": "0.1.0-rc.8",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-browser"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/invariant.js", "lib/client.js", "lib/types/**/*.d.ts"],
  "scripts": { "bundle": "tsdown", "watch": "tsdown --watch" },
  "license": "MIT",
  "dsh": {
    "client": {
      "inject": ["coding-client-connection", "coding-client-locale", "coding-client-runtime", "coding-client-ui-open-in-app"],
      "platform": "web"
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "coding-browser": "workspace:^",
    "coding-client-connection": "workspace:^",
    "coding-client-locale": "workspace:^",
    "coding-client-runtime": "workspace:^",
    "coding-client-ui-conversation": "workspace:^",
    "coding-client-ui-open-in-app": "workspace:^",
    "coding-session": "workspace:^",
    "coding-invariants": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "coding-browser": "workspace:^",
    "coding-client-connection": "workspace:^",
    "coding-session": "workspace:^",
    "coding-client-locale": "workspace:^",
    "coding-client-runtime": "workspace:^",
    "coding-client-test-runtime": "workspace:^",
    "coding-client-ui-icons": "workspace:^",
    "coding-client-ui-conversation": "workspace:^",
    "coding-client-ui-open-in-app": "workspace:^",
    "coding-client-ui-primitives": "workspace:^",
    "coding-client-ui-slots": "workspace:^",
    "coding-invariants": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
