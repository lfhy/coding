// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`sidebar shell snapshots > renders only the sidebar toggle above the New chat entry in the welcome header 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="root quietBars"
    style="width: 300px;"
  >
    <div
      class="topRow"
    >
      <div
        aria-hidden="true"
        class="windowDragInset"
        data-window-drag-inset="true"
        data-window-drag-region="true"
      />
      <button
        aria-label="Collapse sidebar"
        class="iconButton toggle wide"
        type="button"
      >
        <span
          aria-hidden="true"
          aria-label="sidebar"
          class="semi-icon semi-icon-sidebar panelIcon"
          role="img"
          style="font-size: 16px;"
        >
          <svg
            aria-hidden="true"
            data-content="e9ddaac1"
            fill="none"
            focusable="false"
            height="1em"
            viewBox="0 0 24 24"
            width="1em"
            xmlns="http://www.w3.org/2000/svg"
          />
        </span>
      </button>
    </div>
    <div
      class="logoRow"
      data-window-drag-region="true"
    >
      <button
        aria-label="New chat"
        class="newSession wide"
        type="button"
      >
        <svg
          data-content="c0ce4dcc"
          fill="none"
          height="16"
          viewBox="0 0 16 16"
          width="16"
          xmlns="http://www.w3.org/2000/svg"
        />
        <span
          class="newSessionLabel wide"
        >
          New chat
        </span>
      </button>
    </div>
    <div
      class="regionArea"
    >
      <div
        data-slot="sidebar.workspaces"
        style="display: contents;"
      />
    </div>
    <div
      class="footArea"
    >
      <div
        class="footerActions"
      >
        <div
          data-slot="sidebar.footer.action"
          style="display: contents;"
        />
      </div>
      <div
        class="settingsArea"
      >
        <div
          data-slot="sidebar.settings"
          style="display: contents;"
        />
      </div>
    </div>
  </div>
</div>
`;

exports[`sidebar shell snapshots > renders the collapsed rail after the crossfade settles, in place 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="root fading quietBars"
    style="width: 300px;"
  >
    <div
      class="topRow"
    >
      <div
        aria-hidden="true"
        class="windowDragInset"
        data-window-drag-inset="true"
        data-window-drag-region="true"
      />
      <button
        aria-label="Open sidebar"
        class="iconButton toggle wide"
        type="button"
      >
        <span
          aria-hidden="true"
          aria-label="sidebar"
          class="semi-icon semi-icon-sidebar panelIcon"
          role="img"
          style="font-size: 16px;"
        >
          <svg
            aria-hidden="true"
            data-content="e9ddaac1"
            fill="none"
            focusable="false"
            height="1em"
            viewBox="0 0 24 24"
            width="1em"
            xmlns="http://www.w3.org/2000/svg"
          />
        </span>
      </button>
    </div>
    <div
      class="logoRow"
      data-window-drag-region="true"
    >
      <button
        aria-label="New chat"
        class="newSession wide"
        type="button"
      >
        <svg
          data-content="c0ce4dcc"
          fill="none"
          height="16"
          viewBox="0 0 16 16"
          width="16"
          xmlns="http://www.w3.org/2000/svg"
        />
        <span
          class="newSessionLabel wide"
        >
          New chat
        </span>
      </button>
      <div
        class="brandActions"
      >
        <div
          data-slot="sidebar.brand.action"
          style="display: contents;"
        />
      </div>
    </div>
    <div
      class="regionArea"
    >
      <div
        data-slot="sidebar.workspaces"
        style="display: contents;"
      />
    </div>
    <div
      class="footArea"
    >
      <div
        class="footerActions"
      >
        <div
          data-slot="sidebar.footer.action"
          style="display: contents;"
        />
      </div>
      <div
        class="settingsArea"
      >
        <div
          data-slot="sidebar.settings"
          style="display: contents;"
        />
      </div>
    </div>
  </div>
</div>
`;

