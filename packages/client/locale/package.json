{
  "name": "coding-client-locale",
  "description": "Locale plugin: Host-backed zh/en preference, Chinese UI default, locale snapshots, and typed namespace dictionaries",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/locale"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "coding-client-connection",
        "coding-client-runtime",
        "coding-client-ui-settings",
        "coding-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "coding-api-remotes": "workspace:^",
    "coding-client-connection": "workspace:^",
    "coding-client-runtime": "workspace:^",
    "coding-client-ui-settings": "workspace:^",
    "coding-invariants": "workspace:^",
    "coding-settings": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "coding-api-remotes": "workspace:^",
    "coding-client-runtime": "workspace:^",
    "coding-client-test-runtime": "workspace:^",
    "coding-client-ui-primitives": "workspace:^",
    "coding-client-ui-settings": "workspace:^",
    "coding-client-ui-slots": "workspace:^",
    "coding-invariants": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "coding-client-connection": "workspace:^",
    "coding-settings": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  }
}
