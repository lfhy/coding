    "coding-agent": "workspace:^",
    "coding-api-remotes": "workspace:^",
    "coding-attachment": "workspace:^",
    "coding-brand": "workspace:^",
    "coding-client-connection": "workspace:^",
    "coding-client-locale": "workspace:^",
    "coding-client-runtime": "workspace:^",
    "coding-client-ui-settings": "workspace:^",
    "coding-client-ui-input-trigger": "workspace:^",
    "coding-commands": "workspace:^",
    "coding-compaction": "workspace:^",
    "coding-invariants": "workspace:^",
    "coding-llm-retry": "workspace:^",
    "coding-session-stats": "workspace:^",
    "coding-token-meter": "workspace:^",
    "coding-tools": "workspace:^",
    "coding-settings": "workspace:^",
    "coding-client-ui-layout": "workspace:^",
    "coding-goal": "workspace:^",
    "coding-permission-presets": "workspace:^",
    "coding-plan-mode": "workspace:^",
    "coding-tool-todo": "workspace:^"
