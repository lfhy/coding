{
  "name": "coding-client-ui-notes",
  "description": "笔记入口、目录树侧栏、原文编辑与 Markdown 预览，并复用对话 AI 助手",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-notes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "coding-api-remotes",
        "coding-client-locale",
        "coding-client-runtime",
        "coding-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "coding-api-remotes": "workspace:^",
    "coding-client-locale": "workspace:^",
    "coding-client-runtime": "workspace:^",
    "coding-client-ui-layout": "workspace:^",
    "coding-invariants": "workspace:^",
    "coding-session": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "coding-api-remotes": "workspace:^",
    "coding-client-locale": "workspace:^",
    "coding-client-runtime": "workspace:^",
    "coding-client-test-runtime": "workspace:^",
    "coding-client-ui-icons": "workspace:^",
    "coding-client-ui-layout": "workspace:^",
    "coding-client-ui-primitives": "workspace:^",
    "coding-client-ui-slots": "workspace:^",
    "coding-invariants": "workspace:^",
    "coding-session": "workspace:^",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "docx": "^9.15.4",
    "html-to-image": "^1.11.13"
  }
}
