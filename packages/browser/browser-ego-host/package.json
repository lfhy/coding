{
  "name": "coding-browser-ego-host",
  "description": "Session-scoped host adapter for the MIT ego-lite browser runtime",
  "version": "0.1.0-rc.8",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/browser/browser-ego-host"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js", "lib/invariant.js", "runtime/", "bin/",
    "third-party/host/", "LICENSE", "THIRD_PARTY_NOTICES.upstream.md", "NOTICE.md",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "coding-client-connection": "workspace:^",
    "coding-host-webserver": "workspace:^",
    "coding-session": "workspace:^",
    "coding-subprocess": "workspace:^",
    "coding-tools": "workspace:^",
    "coding-invariants": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "coding-client-connection": "workspace:^",
    "coding-host-webserver": "workspace:^",
    "coding-session": "workspace:^",
    "coding-subprocess": "workspace:^",
    "coding-tools": "workspace:^",
    "coding-invariants": "workspace:^"
  }
}
