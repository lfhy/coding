{
  "name": "coding-tool-ppt",
  "description": "PPT 创作模式的模型工具：创建、编辑、撤销、重做与导出演示文稿工程",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/ppt/tool-ppt"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "coding-agent": "workspace:^",
    "coding-attachment": "workspace:^",
    "coding-image-gen": "workspace:^",
    "coding-invariants": "workspace:^",
    "coding-llm": "workspace:^",
    "coding-session": "workspace:^",
    "coding-tools": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "coding-attachment-local": "workspace:^",
    "coding-ppt-workbench": "workspace:^",
    "coding-tool-image-gen": "workspace:^",
    "coding-system-prompt": "workspace:^",
    "fflate": "^0.8.2",
    "coding-agent": "workspace:^",
    "coding-attachment": "workspace:^",
    "coding-image-gen": "workspace:^",
    "coding-invariants": "workspace:^",
    "coding-llm": "workspace:^",
    "coding-session": "workspace:^",
    "coding-tools": "workspace:^"
  }
}
