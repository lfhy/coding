{
  "name": "coding-tool-status",
  "description": "Model-facing current-turn progress updates with a replayable session projection",
  "version": "0.1.0-rc.8",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/tool-status"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./types": { "types": "./lib/types/types.d.ts", "default": "./lib/types/types.js" },
    "./client": { "types": "./lib/types/client.d.ts", "default": "./lib/types/client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/invariant.js", "lib/types/**/*.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "dependencies": { "zod": "^4.4.3" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "coding-agent": "workspace:^",
    "coding-invariants": "workspace:^",
    "coding-session": "workspace:^",
    "coding-session-projection": "workspace:^",
    "coding-tools": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "coding-agent": "workspace:^",
    "coding-agent-loop": "workspace:^",
    "coding-agent-loop-testkit": "workspace:^",
    "coding-host-apiproxy": "workspace:^",
    "coding-invariants": "workspace:^",
    "coding-llm": "workspace:^",
    "coding-progress-reminder": "workspace:^",
    "coding-session": "workspace:^",
    "coding-session-projection": "workspace:^",
    "coding-system-prompt": "workspace:^",
    "coding-tools": "workspace:^",
    "coding-user-questions": "workspace:^"
  }
}
